# 1. Convert the Date column to actual dates if R didn't do it automatically
data$Date <- as.Date(rownames(data))
# 2. Filter for just 2025
data_2025 <- subset(data, Date >= "2025-01-01" & Date <= "2025-12-31")
# 3. Re-run the Model
model_2025 <- lm(PEP ~ KO, data = data_2025)
# 4. Check the "Clean" Plots
plot(model_2025, which = 2, main = "Q-Q Plot: 2025 Data Only")
summary(model_2025)
