x <- c(2500, 2700, 2900, 3100, 3300, 3500, 3700, 3900, 4100, 4300)
n <- c(50, 70, 100, 60, 40, 85, 90, 50, 80, 65)
r <- c(10, 17, 30, 21, 18, 43, 54, 33, 60, 51)
# 2. Run the model
# We use 'r' (Number Failing) and 'n-r' (Number NOT failing)
fit_fastener <- glm(cbind(r, n - r) ~ x, family = binomial)
# 3. Get the high-precision coefficients
summary(fit_fastener)$coefficients
x <- c(2500, 2700, 2900, 3100, 3300, 3500, 3700, 3900, 4100, 4300)
n <- c(50, 70, 100, 60, 40, 85, 90, 50, 80, 65)
r <- c(10, 17, 30, 21, 18, 43, 54, 33, 60, 51)
# 2. Run the model
# We use 'r' (Number Failing) and 'n-r' (Number NOT failing)
fit_fastener <- glm(cbind(r, n - r) ~ x, family = binomial)
# 3. Get the high-precision coefficients
summary(fit_fastener)
# 1. Load the data
# This opens a window to select the 'coke_pepsi_returns.csv' file from your Desktop
data <- read.csv(file.choose(), row.names = 1)
# 2. Plot A: Just the cloud
plot(data$KO, data$PEP, main="Plot A: Scatter", xlab="KO Returns", ylab="PEP Returns")
# 3. Plot B: The Regression
model <- lm(PEP ~ KO, data = data)
plot(data$KO, data$PEP, main="Plot B: Regression", xlab="KO Returns", ylab="PEP Returns")
abline(model, col="red")
# 4. Results & Diagnostics
summary(model)       # Get your numbers here
plot(model, which=1) # Residuals vs Fitted
plot(model, which=2) # Normal Q-Q
# 1. Load the data
# This opens a window to select the 'coke_pepsi_returns.csv' file from your Desktop
data <- read.csv(file.choose(), row.names = 1)
# 2. Plot A: Just the cloud
plot(data$KO, data$PEP, main="Scatter", xlab="KO Returns", ylab="PEP Returns")
# 3. Plot B: The Regression
model <- lm(PEP ~ KO, data = data)
plot(data$KO, data$PEP, main="Regression", xlab="KO Returns", ylab="PEP Returns")
abline(model, col="red")
if(!require(car)) install.packages("car")
library(car)
# Run the test
durbinWatsonTest(model)
# 4. Results & Diagnostics
summary(model)       # Get your numbers here
plot(model, which=1) # Residuals vs Fitted
plot(model, which=2) # Normal Q-Q
