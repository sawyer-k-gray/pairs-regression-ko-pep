source("~/STAT5680 Regression Analysis/Lecture2.R")
source("~/STAT5680 Regression Analysis/Lecture2.R")
library(alr3)
library(ggplot2)
data(heights)
dim(heights)
heights[1:5,]
ggplot(heights, aes(x=Mheight,y=Dheight)) + geom_point() +
labs(x='Mother height (inches)',y='Daughter height (inches)') +
theme(text = element_text(size= 15))
# x is the predictor (independent variable), y is the response (dependent variable)
# a functional relation between x and y is y=f(x)
# for a statistical relation the data points do not exactly fall of the curve of the relationship
x = heights$Mheight; y = heights$Dheight;
x.bar = mean(x); y.bar = mean(y);
xx.bar = x - x.bar
yy.bar = y - y.bar
xy.bar = xx.bar * yy.bar
tableLS = matrix(0, nrow(heights), 7)
tableLS = cbind(x, y, xx.bar, yy.bar, xy.bar, xx.bar^2, xx.bar^2)
colnames(tableLS) = c('x', 'y', 'xx.bar', 'yy.bar',
'xy.bar', 'xx.bar2', 'yy.bar2')
tableLS[1:5, ]
beta1.hat = sum(xx.bar*yy.bar)/sum(xx.bar^2)
beta0.hat = y.bar - beta1.hat*x.bar
c(beta0.hat = beta0.hat, beta1.hat = beta1.hat)
lm(Dheight ~ Mheight, data = heights)
lrmodel = lm(Dheight ~ Mheight, data = heights)
summary(lrmodel)
ggplot(heights, aes(x = Mheight, y=Dheight)) + geom_point() +
labs(x='Mother height', y='Daughter height') +
theme(text = element_text(size=25)) +
geom_smooth(method = 'lm', formula = y~x, se=False)
ggplot(heights, aes(x = Mheight, y=Dheight)) + geom_point() +
labs(x='Mother height', y='Daughter height') +
theme(text = element_text(size=25)) +
geom_smooth(method = 'lm', formula = y~x, se= FALSE)
